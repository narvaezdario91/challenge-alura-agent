# LLM & Embedding Server Configuration (Providers: lm_studio | openai | cohere)
LLM_PROVIDER=lm_studio
LLM_BASE_URL=http://127.0.0.1:1234/v1
# For LM Studio: qwen2.5-coder-7b-instruct | For Cohere: command-r-08-2024
LLM_MODEL_NAME=qwen2.5-coder-7b-instruct
# For LM Studio: nomic-ai/nomic-embed-text-v1.5-GGUF | For Cohere: embed-multilingual-v3.0
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5-GGUF
LLM_API_KEY=lm-studio
COHERE_API_KEY=your_cohere_api_key_here
LLM_TEMPERATURE=0.1
LLM_STREAMING=true

# RAG & Vector Store Configuration
KNOWLEDGE_BASE_DIR=knowledge_base
CHUNK_SIZE=800
CHUNK_OVERLAP=150
